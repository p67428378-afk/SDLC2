# Database connection string
DATABASE_URL=sqlite:////tmp/test.db

# Secret key for JWT token signing
JWT_SECRET_KEY=dev-secret-change-in-production

# MFA code TTL in seconds (default 300 = 5 minutes)
MFA_CODE_TTL_SECONDS=300

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Fiserv Integration Config
FISERV_MODE=mock
FISERV_API_KEY=mock-key
FISERV_API_SECRET=mock-secret
FISERV_TOKEN_URL=http://localhost:8000/v1/oauth/token
FISERV_BASE_URL=http://localhost:8000
FISERV_ORG_ID=mock-org
FISERV_DEMO_ACCOUNTS=CIF-982341
