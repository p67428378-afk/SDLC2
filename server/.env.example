# Database connection string
DATABASE_URL=sqlite:////tmp/test.db

# Secret key for JWT token signing
JWT_SECRET_KEY=dev-secret-change-in-production

# MFA code TTL in seconds (default 300 = 5 minutes)
MFA_CODE_TTL_SECONDS=300

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Fiserv Integration Config
FISERV_MODE=mock
FISERV_API_KEY=mock-key
FISERV_API_SECRET=mock-secret
FISERV_TOKEN_URL=https://bankinghub-cert.fiservapis.com/fts-apim/oauth2/v2
FISERV_BASE_URL=https://bankinghub-cert.fiservapis.com/banking/efx/v1
FISERV_ORG_ID=999990301
# Fiserv Party ID for live mode (optional, triggers fallback if unset)
FISERV_PARTY_ID=
FISERV_DEMO_ACCOUNTS=5041733:DDA,302034131:SDA,290001702:CDA
