# Environment variables for local development.
# Copy to .env and adjust values:  cp .env.example .env

# Database connection string
DATABASE_URL=sqlite:///./test.db
# Secret key for JWT token signing
JWT_SECRET_KEY=dev-secret-change-in-production
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Auto-added at push: vars read by the code but missing above ---
# Read by the backend code (FISERV_API_KEY)
FISERV_API_KEY=changeme
# Read by the backend code (FISERV_API_SECRET)
FISERV_API_SECRET=changeme
# Read by the backend code (FISERV_BASE_URL)
FISERV_BASE_URL=changeme
# Read by the backend code (FISERV_DEMO_ACCOUNTS)
FISERV_DEMO_ACCOUNTS=changeme
# Read by the backend code (FISERV_MODE)
FISERV_MODE=mock
# Read by the backend code (FISERV_ORG_ID)
FISERV_ORG_ID=changeme
# Read by the backend code (FISERV_TOKEN_URL)
FISERV_TOKEN_URL=changeme
