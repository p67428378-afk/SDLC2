      "get": {
        "summary": "Get Payment Receipt",
        "description": "Generates and returns a receipt for a completed payment.",
        "operationId": "get_payment_receipt_api_v1_mortgage_payments__payment_id__receipt_get",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "parameters": [
          {
            "name": "payment_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Payment Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentReceiptResponse"
