                  "type": "array",
                  "title": "Response Get Scheduled Payments Api V1 Mortgage Payments Scheduled Get"
                }
              }
            }
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ]
      }
    },
