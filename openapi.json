{
  "openapi": "3.1.0",
  "info": {
    "title": "Nexus Bank Mortgage Payment API",
    "description": "API for customer-initiated mortgage payments from DDA/Savings accounts",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "summary": "Login",
        "operationId": "login_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/mortgage/accounts": {
      "get": {
        "summary": "Get Eligible Accounts",
        "description": "Retrieve a list of the customer's eligible DDA/Savings accounts from Fiserv.",
        "operationId": "get_eligible_accounts_api_v1_mortgage_accounts_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AccountResponse"
                  },
                  "type": "array",
                  "title": "Response Get Eligible Accounts Api V1 Mortgage Accounts Get"
                }
              }
            }
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ]
      }
    },
    "/api/v1/mortgage/payments/validate": {
      "post": {
        "summary": "Validate Payment",
        "description": "Validates that a source account has sufficient available balance for a given payment amount.",
        "operationId": "validate_payment_api_v1_mortgage_payments_validate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PaymentValidateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentValidateResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ]
      }
    },
    "/api/v1/mortgage/payments": {
      "post": {
        "summary": "Create Payment",
        "description": "Submits a new mortgage payment instruction (for immediate or scheduled payments).",
        "operationId": "create_payment_api_v1_mortgage_payments_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PaymentCreateRequest"
              }
