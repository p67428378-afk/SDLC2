      "get": {
        "summary": "Get Payment Detail",
        "description": "Retrieves the status and details of a specific payment transaction.",
        "operationId": "get_payment_detail_api_v1_mortgage_payments__payment_id__get",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "parameters": [
          {
            "name": "payment_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Payment Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
